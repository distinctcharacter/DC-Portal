# Distinct Character Protocol Portal
# Current backend: Clerk authentication + Neon database + WooCommerce checkout.
# Do not place live secrets in source control.

# Public portal URLs
NEXT_PUBLIC_PORTAL_URL=https://portal.distinctcharacter.com
NEXT_PUBLIC_MARKETING_SITE_URL=https://distinctcharacter.com

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_with_clerk_publishable_key
CLERK_SECRET_KEY=replace_with_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/access/claim
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/access/claim

# Neon database
DATABASE_URL=replace_with_neon_pooled_database_connection_string

# WooCommerce webhook
WOOCOMMERCE_WEBHOOK_SECRET=replace_with_woocommerce_webhook_secret

# Founder/admin access
FOUNDER_ADMIN_EMAILS=stephanie@granitefieldholdings.com

# Optional Stripe fallback/direct-link support
# Keep these only if Stripe payment links remain active as standalone purchase paths.
STRIPE_SECRET_KEY=replace_if_using_stripe_payment_links
STRIPE_WEBHOOK_SECRET=replace_if_using_stripe_payment_links
