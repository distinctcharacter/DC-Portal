{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "_shared",
    "components/Supabase*.ts",
    "components/Supabase*.tsx",
    "claim-purchases.ts",
    "founder-orders.ts",
    "mark-protocol-complete.ts",
    "neon-clerk-healthcheck.ts",
    "portal-access.ts",
    "portal-catalog.ts",
    "practitioner-workspace.ts",
    "protected-resource.ts",
    "save-practice-log.ts",
    "save-practitioner-note.ts",
    "stripe-webhook.ts",
    "supabase-healthcheck.ts",
    "woocommerce-webhook.ts",
    "UPLOAD_*",
    "UPLOAD_THIS_TO_GITHUB",
    "github-upload"
  ]
}
